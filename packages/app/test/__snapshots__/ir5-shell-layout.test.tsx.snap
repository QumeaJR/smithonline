exports[`Shell slot placement > 390 px: top bar, the pinned chart and the main sheet with Network | Numbers | Tools 1`] = `"<div class="app layout-phone view-chart"><header data-slot="topbar">topbar</header><main tabindex="-1" class="chart-area phone-hero"><div data-slot="chart">chart</div></main><section class="panel-sheet detent-half" aria-label="Panels" data-detent="half" style="--panel-h: 410px;"><button type="button" class="sheet-grab" aria-label="Panel size: half. Press to change, or drag"><span class="sheet-grabber" aria-hidden="true"></span></button><div class="panel-sheet-head"><div class="segmented panel-tabs" role="tablist" aria-label="Panels"><span class="segmented-thumb" aria-hidden="true"></span><button type="button" role="tab" class="segmented-option on" aria-selected="true" tabindex="0">Network</button><button type="button" role="tab" class="segmented-option" aria-selected="false" tabindex="-1">Numbers</button><button type="button" role="tab" class="segmented-option" aria-selected="false" tabindex="-1">Tools</button></div></div><div class="panel-sheet-body"><div class="pane pane-network" data-pane="network"><div class="slot-host slot-network"><div data-slot="network">network</div></div></div><div class="pane pane-numbers numbers" data-pane="numbers" hidden=""><div class="slot-host slot-numbers"><div data-slot="numbers">numbers</div></div></div><div class="pane pane-tools" data-pane="tool" hidden=""><ul class="tools-list" aria-label="Tools"><li><button type="button" class="tools-row"><span class="tools-row-text"><strong>Auto match</strong><span class="desc">Reach the target: add L, Pi or T parts ranked by Q, yield or VSWR, tune the parts already in the network, search a broadband match, or design a quarter-wave transformer or a stub filter</span></span><svg class="icon " width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 4l4 4-4 4"></path></svg></button></li><li><button type="button" class="tools-row"><span class="tools-row-text"><strong>Optimize band</strong><span class="desc">Improve the element values for the lowest worst-case VSWR over the sweep range</span></span><svg class="icon " width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 4l4 4-4 4"></path></svg></button></li><li><button type="button" class="tools-row"><span class="tools-row-text"><strong>Tolerance</strong><span class="desc">Random part values within their tolerances: the cloud of input impedances, the VSWR histogram, the yield, which part dominates the spread, and design centring</span></span><svg class="icon " width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 4l4 4-4 4"></path></svg></button></li></ul></div></div></section></div>"`;

exports[`Shell slot placement > 768 px: two columns, the chart and one side column Network | Numbers 1`] = `"<div class="app layout-tablet view-chart"><header data-slot="header">header</header><main tabindex="-1" class="chart-area"><div data-slot="chart">chart</div></main><aside class="right side-column side-tablet" aria-label="Side panels"><div class="side-top"><div class="slot-host slot-tour"><div data-slot="tour">tour</div></div></div><div class="tool-strip"><div class="tool-strip-row"><div class="segmented sm tool-strip-tabs" role="tablist" aria-label="Side column"><span class="segmented-thumb" aria-hidden="true"></span><button type="button" role="tab" class="segmented-option on" aria-selected="true" tabindex="0">Network</button><button type="button" role="tab" class="segmented-option" aria-selected="false" tabindex="-1">Numbers</button></div></div></div><div class="side-scroll"><div class="pane pane-network" data-pane="network"><div class="slot-host slot-network"><div data-slot="network">network</div></div></div><div class="pane pane-numbers numbers" data-pane="numbers" hidden=""><div class="slot-host slot-numbers"><div data-slot="numbers">numbers</div></div></div></div></aside><footer data-slot="status">status</footer></div>"`;

exports[`Shell slot placement > 1440 px: three columns, network left, chart, numbers right 1`] = `"<div class="app layout-wide view-chart"><header data-slot="header">header</header><aside class="left" aria-label="Network"><div class="slot-host slot-tour"><div data-slot="tour">tour</div></div><div class="slot-host slot-network"><div data-slot="network">network</div></div></aside><main tabindex="-1" class="chart-area"><div data-slot="chart">chart</div></main><aside class="right side-column side-desktop" aria-label="Side panels"><div class="side-scroll"><div class="pane pane-numbers numbers" data-pane="numbers"><div class="slot-host slot-numbers"><div data-slot="numbers">numbers</div></div></div></div></aside><footer data-slot="status">status</footer></div>"`;
