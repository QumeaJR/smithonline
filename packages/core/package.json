{
  "name": "@smithonline/core",
  "version": "0.5.0",
  "private": true,
  "description": "Smith Online core library: complex math, elements, ladder evaluation, circles, file formats. No DOM dependency.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=20000",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
